{
  "name": "@irrigation/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "test:mqtt": "RUN_MQTT_INTEGRATION=1 node --import tsx --test test/mqtt.integration.test.ts"
  },
  "dependencies": { "fastify": "5.12.8", "mqtt": "5.16.1",
    "@irrigation/contracts": "0.1.0", "@irrigation/data": "0.1.0", "@irrigation/intelligence": "0.1.0" },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript-eslint": "8.46.3"
  }
}
